<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1"
         metadata-complete="true">

  <!-- 1. 商品模块 Servlet -->
  <servlet>
    <servlet-name>ProductServlet</servlet-name>
    <servlet-class>com.erp.servlet.ProductServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ProductServlet</servlet-name>
    <url-pattern>/product</url-pattern>
  </servlet-mapping>

  <!-- 2. 登录模块 Servlet -->
  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>com.erp.servlet.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <!-- 3. 权限拦截器 Filter (核心！) -->
  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>com.erp.filter.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <!-- /* 表示拦截所有请求 -->
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- 4. 退出登录 Servlet -->
  <servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>com.erp.servlet.LogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>

  <!-- 5. 采购订单模块 Servlet -->
  <servlet>
    <servlet-name>PurchaseOrderServlet</servlet-name>
    <servlet-class>com.erp.servlet.PurchaseOrderServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PurchaseOrderServlet</servlet-name>
    <url-pattern>/purchase_order</url-pattern>
  </servlet-mapping>

  <!-- 6. 【新增】采购申请模块 Servlet -->
  <servlet>
    <servlet-name>PurchaseRequestServlet</servlet-name>
    <servlet-class>com.erp.servlet.PurchaseRequestServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PurchaseRequestServlet</servlet-name>
    <url-pattern>/purchase_request</url-pattern>
  </servlet-mapping>

  <!-- JSP自定义标签库配置 -->
  <jsp-config>
    <taglib>
      <taglib-uri>http://erp.com/tags</taglib-uri>
      <taglib-location>/WEB-INF/erp.tld</taglib-location>
    </taglib>
  </jsp-config>

</web-app>